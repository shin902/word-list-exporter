GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE_DO_NOT_COMMIT_REAL_KEY
# フロントエンド開発サーバーのURL (CORS設定に必須)
# 例: http://localhost:5500, http://127.0.0.1:5500
# 未設定の場合、開発環境では 'http://localhost:5500' がデフォルト値として使用されます。
# 実際の開発環境に合わせて設定してください。
FRONTEND_URL=http://localhost:5500
PORT=3000
NODE_ENV=development
# Redis/KV URL (Required in production)
# KV_URL=redis://...
# REDIS_URL=redis://...
